# Foundry Agent Service project endpoint.
FOUNDRY_PROJECT_ENDPOINT=https://sivris-development-resource.services.ai.azure.com/api/projects/sivris-development

# Model deployment name shared by the orchestrator and both sub-agents.
AZURE_AI_MODEL_DEPLOYMENT_NAME=claude-sonnet-4-6

# Shared toolbox MCP endpoint (the toolbox is created/managed in Foundry).
FOUNDRY_TOOLBOX_MCP_URL=https://sivris-development-resource.services.ai.azure.com/api/projects/sivris-development/toolboxes/nc-foundry-toolbox-sivris-core/mcp?api-version=v1
